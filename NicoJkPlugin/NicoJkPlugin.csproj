<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputType>Library</OutputType>
    <RootNamespace>NicoJkPlugin</RootNamespace>
    <AssemblyName>NicoJkPlugin</AssemblyName>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TvAIrPlugin\TvAIrPlugin.csproj" Private="false" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TvAIrPluginDeployDir Condition="'$(TvAIrPluginDeployDir)' == ''"></TvAIrPluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\plugin.json" Link="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployPluginForLocalTest" AfterTargets="Build" Condition="'$(TvAIrPluginDeployDir)' != ''">
    <MakeDir Directories="$(TvAIrPluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TvAIrPluginDeployDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\plugin.json" DestinationFolder="$(TvAIrPluginDeployDir)" Condition="Exists('$(MSBuildProjectDirectory)\..\plugin.json')" />
  </Target>
</Project>
